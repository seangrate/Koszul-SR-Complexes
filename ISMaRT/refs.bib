@article{migliore_monomial_2011,
	title = {Monomial ideals, almost complete intersections and the {Weak} {Lefschetz} property},
	volume = {363},
	issn = {0002-9947, 1088-6850},
	shorttitle = {Survey {Article}},
	url = {https://www.ams.org/journals/tran/2011-363-01/S0002-9947-2010-05127-X/},
	doi = {10.1090/S0002-9947-2010-05127-X },
	abstract = {Many algebras are expected to have the Weak Lefschetz property, although this is often very difficult to establish. We illustrate the subtlety of the problem by studying monomial and some closely related ideals. Our results exemplify the intriguing dependence of the property on the characteristic of the ground field and on arithmetic properties of the exponent vectors of the monomials.},
	number = {1},
	urldate = {2026-01-06},
	journal = {Transactions of the American Mathematical Society},
	author = {Migliore, Juan and Miró-Roig, Rosa and Nagel, Uwe},
	month = jan,
	year = {2011},
	pages = {229--257},
}

@article{migliore_quadratic_2020, 
	title={The weak {Lefschetz} property for quotients by quadratic monomials}, 
	author={Migliore, Juan and Nagel, Uwe and Schenck, Hal}, 
	volume={126}, 
	url={https://www.mscand.dk/article/view/116681}, 
	DOI={10.7146/math.scand.a-116681}, 
	abstractNote={&amp;lt;p&amp;gt;Michałek and Miró-Roig, in J. Combin. Theory Ser.&amp;amp;nbsp;A 143 (2016), 66–87, give a beautiful geometric characterization of Artinian quotients by ideals generated by quadratic or cubic monomials, such that the multiplication map by a general linear form fails to be injective in the first nontrivial degree. Their work was motivated by conjectures of Ilardi and Mezzetti, Miró-Roig and&amp;amp;nbsp;Ottaviani, connecting the failure to Laplace equations and classical results of Togliatti on osculating planes. We study quotients by quadratic monomial ideals, explaining failure of the Weak Lefschetz Property for some cases not covered by Michałek and&amp;amp;nbsp;Miró-Roig.&amp;lt;/p&amp;gt;}, 
	number={1}, 
	journal={MATHEMATICA SCANDINAVICA}, 
	year={2020}, 
	month={Mar.}, 
	pages={41–60}
}

@article{migliore_survey_2013,
	title = {Survey {Article}: {A} tour of the weak and strong {Lefschetz} properties},
	volume = {5},
	issn = {1939-2346},
	shorttitle = {Survey {Article}},
	url = {https://projecteuclid.org/journals/journal-of-commutative-algebra/volume-5/issue-3/Survey-Article--A-tour-of-the-weak-and-strong/10.1216/JCA-2013-5-3-329.full},
	doi = {10.1216/JCA-2013-5-3-329},
	abstract = {An artinian graded algebra, \$A\$, is said to have the weak Lefschetz property (WLP) if multiplication by a general linear form has maximal rank in every degree. A vast quantity of work has been done studying and applying this property, touching on numerous and diverse areas of algebraic geometry, commutative algebra and combinatorics. Amazingly, though, much of this work has a ``common ancestor" in a theorem originally due to Stanley, although subsequently reproved by others. In this paper we describe the different directions in which research has moved starting with this theorem, and we discuss some of the open questions that continue to motivate current research.},
	number = {3},
	urldate = {2023-05-31},
	journal = {Journal of Commutative Algebra},
	author = {Migliore, Juan and Nagel, Uwe},
	month = sep,
	year = {2013},
	pages = {329--358},
}

